rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email == 'admin@prabunet.sch.id' ||
        request.auth.token.email == 'aamuisx@gmail.com'
      );
    }

    // 1. Koleksi pendaftar (PPDB / Registrasi Siswa Baru)
    // Siswa / Publik dapat mendaftarkan diri (create).
    // Siswa dapat membaca & mengupdate data pendaftaran miliknya sendiri.
    // Admin memiliki akses penuh (read, write, delete, verifikasi).
    match /pendaftar/{pendaftarId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && (request.auth.uid == pendaftarId || resource.data.uid == request.auth.uid));
      allow update: if isAdmin() || (isAuthenticated() && (request.auth.uid == pendaftarId || resource.data.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // 2. Koleksi bank_soal (Manajemen Soal CBT)
    // Admin dapat membuat, mengubah, menghapus soal, dan melihat seluruh field.
    // Siswa/publik dapat membaca soal yang statusnya aktif ('status == "aktif"' atau 'isActive == true').
    match /bank_soal/{soalId} {
      allow read: if isAdmin() || resource.data.status == 'aktif' || resource.data.isActive == true;
      allow write: if isAdmin();
    }

    // 3. Koleksi hasil_ujian (Hasil Pengerjaan Siswa)
    // Siswa dapat membuat dan mengupdate progres ujian miliknya sendiri secara bertahap (auto-save).
    // Admin dapat membaca dan mengevaluasi seluruh hasil ujian.
    match /hasil_ujian/{hasilId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.pendaftarId == request.auth.uid)) || (resource.data.studentId == request.auth.uid);
      allow update: if isAdmin() || (request.resource.data.studentId == resource.data.studentId);
      allow delete: if isAdmin();
    }

    // Default deny for other paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
